{
  "name": "theta-python",
  "version": "1.2.0",
  "description": "Python by THETA172 — Precision Python IDE",
  "author": "THETA172 / nothing frontend team",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k -s first -n VITE,ELECTRON -c cyan,magenta \"vite\" \"npx wait-on tcp:5173 -t 15000 && npm run electron:start\"",
    "electron:build": "node scripts/fetch-python.cjs && vite build && electron-builder --win --x64",
    "electron:build:dir": "node scripts/fetch-python.cjs && vite build && electron-builder --win --x64 --dir",
    "electron:preview": "vite build && cross-env NODE_ENV=production electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vite build && node scripts/smoke.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "shots": "vite build && node scripts/shots.cjs",
    "fetch:python": "node scripts/fetch-python.cjs",
    "release": "node scripts/release.cjs",
    "license": "node scripts/license.cjs",
    "update-server": "node scripts/update-server.cjs"
  },
  "build": {
    "compression": "normal",
    "appId": "com.theta172.python",
    "productName": "Python by THETA172",
    "copyright": "Copyright © 2025 THETA172",
    "asar": true,
    "asarUnpack": [
      "node_modules/ws/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/basedpyright/**/*",
      "electron/kernel/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "relay-server/{server.js,package.json,Dockerfile,.dockerignore}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,LICENSE,license,LICENCE}",
      "!**/*.{ts,map,md}",
      "!scripts/**/*",
      "!src/**/*",
      "!public/**/*",
      "!.git/**/*",
      "!.github/**/*",
      "!.gitignore",
      "!vite.config.js",
      "!node_modules/node-pty/{deps,src,third_party,scripts,typings}/**/*",
      "!node_modules/node-pty/prebuilds/darwin-*/**/*",
      "!node_modules/node-pty/**/*.pdb",
      "!vendor/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Python-by-THETA172-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Python by THETA172",
      "uninstallDisplayName": "Python by THETA172",
      "installerIcon": "build-assets/icon.ico",
      "uninstallerIcon": "build-assets/icon.ico",
      "installerHeader": "build-assets/installer-header.bmp",
      "installerSidebar": "build-assets/installer-sidebar.bmp",
      "installerHeaderIcon": "build-assets/icon.ico",
      "menuCategory": "THETA172",
      "license": null,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build-assets/icon_1024.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "artifactName": "Python-by-THETA172-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Python by THETA172",
      "iconSize": 80,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build-assets/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shriomverma100",
        "repo": "theta172-python-ide"
      }
    ],
    "extraResources": [
      {
        "from": "vendor/${os}-${arch}/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/idle_test/**"
        ]
      },
      {
        "from": "build-assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "vendor/${os}-${arch}/uv",
        "to": "uv"
      },
      {
        "from": "vendor/${os}-${arch}/ruff",
        "to": "ruff"
      },
      {
        "from": "vendor/${os}-${arch}/debugpy",
        "to": "debugpy"
      }
    ],
    "npmRebuild": false
  },
  "devDependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/lsp-client": "6.3.0",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.42.0",
    "@eslint/js": "^9.39.5",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lib0": "^0.2.117",
    "pixelfx": "github:patch-gg/pixelfx#a84159688af3ca37a4be05a0d422b94451b2e24e",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.9.10",
    "sharp": "^0.34.5",
    "vite": "^8.0.10",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "basedpyright": "1.40.2",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.11.1",
    "node-pty": "1.1.0",
    "ws": "^8.21.0"
  }
}
